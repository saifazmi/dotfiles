# Ghostty Terminal Configuration
# https://ghostty.org/docs

# THEME - Catppuccin Mocha {{{

# Background and foreground
background = 1e1e2e
foreground = cdd6f4

# Cursor
cursor-color = f5e0dc
cursor-text = 1e1e2e

# Selection
selection-background = 585b70
selection-foreground = cdd6f4

# Normal colors
palette = 0=45475a
palette = 1=f38ba8
palette = 2=a6e3a1
palette = 3=f9e2af
palette = 4=89b4fa
palette = 5=f5c2e7
palette = 6=94e2d5
palette = 7=bac2de

# Bright colors
palette = 8=585b70
palette = 9=f38ba8
palette = 10=a6e3a1
palette = 11=f9e2af
palette = 12=89b4fa
palette = 13=f5c2e7
palette = 14=94e2d5
palette = 15=a6adc8

#}}}

# CURSOR {{{

cursor-style = block
cursor-style-blink = true

#}}}

# FONT {{{

font-family = "Comic Code Ligatures"
font-size = 14

# Enable ligatures
font-feature = +calt
font-feature = +liga

#}}}

# WINDOW {{{

window-padding-x = 8
window-padding-y = 4

# Initial window size
window-width = 100
window-height = 40

#}}}

# TERMINAL {{{

# Very large scrollback (Ghostty doesn't support -1 for unlimited)
# Using 1 million lines instead
scrollback-limit = 1000000

# Terminal type
term = xterm-256color

#}}}

# SHELL {{{

# Disable shell integration cursor feature
shell-integration-features = no-cursor

#}}}
