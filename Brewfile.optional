# Nice-to-have apps and tools, installed via `brew bundle --file=Brewfile.optional`.
# Kept separate from the main Brewfile so `make install` can offer this as an
# opt-in step, same pattern as Brewfile.mas. Category comments mirror the
# main Brewfile — some categories have members in both files.

# Terminal
brew 'asciinema'

# CLI utilities
brew 'fastfetch'
brew 'hexedit'
brew 'w3m'
brew 'wget'

# Compression & archiving
brew 'sevenzip'
brew 'unar'

# Networking
brew 'arp-scan-rs'
cask 'charles'
brew 'cloudflare-speed-cli'
cask 'little-snitch'
cask 'localcan'

# AI
cask 'chatgpt'
cask 'codex'

# Utilities
brew 'clang-format'
brew 'cmake'
cask 'docker-desktop'
brew 'hugo'
brew 'jupyterlab'
brew 'presenterm'
brew 'yt-dlp'

